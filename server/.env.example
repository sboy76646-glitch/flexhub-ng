MONGO_URI=mongodb://127.0.0.1:27017/flexhub-ng
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
CLIENT_URL=http://localhost:5180
NODE_ENV=development

# Transactional email (Resend)
# For production, verify flex-hub.com.ng in Resend and use an address on that domain.
RESEND_API_KEY=
EMAIL_FROM=FlexHub NG <no-reply@flex-hub.com.ng>

# FlexGuide shopping adviser and listing quality checks (Google Gemini)
# Create the key in Google AI Studio. Keep it on the server and never add it to VITE_* client variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Paystack payments (use test keys during review)
PAYSTACK_SECRET_KEY=

# Bank-transfer payments (disabled until the checkout and reconciliation workflow is approved)
BANK_TRANSFER_PAYMENTS_ENABLED=false
FLEXHUB_BANK_NAME=
FLEXHUB_BANK_ACCOUNT_NAME=
FLEXHUB_BANK_ACCOUNT_NUMBER=
PAYMENT_REFERENCE_PREFIX=FH
BANK_TRANSFER_EXPIRY_HOURS=24

# Marketplace rules
DELIVERY_FEE_NAIRA=0
PAYOUT_HOLD_DAYS=7

# Safety switches: leave both off until payout testing and approval are complete.
ENABLE_PAYSTACK_TRANSFERS=false
ENABLE_AUTOMATED_PAYOUTS=false

GOOGLE_CLIENT_ID=YOUR_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:5000/api/gmail/oauth/callback
GMAIL_MONITORED_ADDRESS=YOUR_GMAIL_ADDRESS
GMAIL_TRANSACTION_SEARCH_QUERY=

WHATSAPP_ENABLED=false

WHATSAPP_ACCESS_TOKEN=PASTE_YOUR_META_TOKEN_HERE
WHATSAPP_PHONE_NUMBER_ID=PASTE_PHONE_NUMBER_ID_HERE
WHATSAPP_VERIFY_TOKEN=flexhub-whatsapp-verify-2026
WHATSAPP_BUSINESS_ACCOUNT_ID=PASTE_BUSINESS_ACCOUNT_ID_HERE